{
	"name": "opentrick",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"description": "Four-player contract bridge in the browser, peer to peer: public trackers for the first contact, WebRTC for the game and the call.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"bot": "node --env-file-if-exists=.env --import tsx src/bot/cli.ts",
		"benchmark:play": "node --env-file-if-exists=.env --import tsx scripts/benchmark-play.ts",
		"benchmark:3nt": "node --import tsx scripts/benchmark-notrump.ts",
		"demo:bot": "node --env-file-if-exists=.env --import tsx scripts/demo-bot.ts",
		"test:e2e": "playwright test",
		"test:e2e:live": "E2E_LIVE=1 playwright test tests/e2e/live-robots.spec.ts"
	},
	"dependencies": {
		"@bridge-tools/core": "0.3.1",
		"@noble/secp256k1": "3.2.0",
		"@openrouter/agent": "0.11.0",
		"@trystero-p2p/core": "0.26.0",
		"bridge-dds": "1.4.0",
		"mqtt": "5.16.0",
		"werift": "0.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"@vitest/browser-playwright": "5.0.5",
		"mqtt-packet": "9.0.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
